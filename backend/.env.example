# ===== ResQFlow — environment template (copy to .env, never invent/commit real secrets) =====
# App
NODE_ENV=development
# Backend
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Database — MongoDB Atlas (Mongoose). Use the +srv form on normal networks:
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/resqflow?retryWrites=true&w=majority
# Optional: dedicated test database URI (vitest derives a resqflow_test URI from MONGODB_URI when unset)
MONGODB_URI_TEST=
# Auth (generate your own long random values locally; placeholders only)
JWT_SECRET=change_me_to_a_long_random_local_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Frontend (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
