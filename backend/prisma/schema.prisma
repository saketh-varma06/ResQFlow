// ResQFlow — Prisma schema (Phase 2)
// PostgreSQL. All 10 domain models with relations, enums, unique constraints and indexes.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  RESPONDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum Severity {
  CRITICAL
  HIGH
  MODERATE
  LOW
}

enum IncidentType {
  FLOOD
  FIRE
  STORM
  LANDSLIDE
  INFRASTRUCTURE
  UTILITY
  MEDICAL
  HAZMAT
  OTHER
}

enum IncidentStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SOSStatus {
  SUBMITTED
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum SOSCategory {
  FLOOD
  FIRE
  LANDSLIDE
  MEDICAL
  TRAPPED
  INFRASTRUCTURE
  OTHER
}

enum PriorityLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ShelterStatus {
  OPEN
  NEARLY_FULL
  FULL
  CLOSED
}

enum AlertStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum NotificationType {
  ALERT
  INCIDENT_UPDATE
  SOS_UPDATE
  REQUEST_UPDATE
  SHELTER
  SYSTEM
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ResponderReadiness {
  AVAILABLE
  DEPLOYED
  STANDBY
  OFF_DUTY
}

enum AuditResult {
  SUCCESS
  DENIED
  WARNING
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  name         String
  passwordHash String
  role         UserRole   @default(CITIZEN)
  status       UserStatus @default(ACTIVE)
  tokenVersion Int        @default(0)
  area         String?
  address      String?
  bloodGroup   String?
  medicalNotes String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  responderProfile  ResponderProfile?
  incidentsReported Incident[]              @relation("IncidentReporter")
  sosRequests       SOSRequest[]            @relation("SOSCitizen")
  notifications     Notification[]
  assignmentsMade   IncidentAssignment[]    @relation("AssignmentCreator")
  statusChanges     IncidentStatusHistory[] @relation("StatusChangedBy")
  sosStatusChanges  SOSStatusHistory[]      @relation("SOSStatusChangedBy")
  alertsIssued      DisasterAlert[]         @relation("AlertIssuer")
  sheltersCreated   Shelter[]               @relation("ShelterCreator")
  auditLogs         AuditLog[]              @relation("AuditActor")

  @@index([role])
  @@index([status])
  @@index([area])
}

model ResponderProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitName    String
  unitType    String
  base        String
  members     Int                @default(1)
  readiness   ResponderReadiness @default(STANDBY)
  rating      Float?
  serviceArea String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  assignments    IncidentAssignment[]
  sosAssignments SOSRequest[]         @relation("SOSResponder")

  @@index([readiness])
  @@index([unitType])
}

model Incident {
  id               String         @id @default(cuid())
  title            String
  type             IncidentType
  severity         Severity
  status           IncidentStatus @default(SUBMITTED)
  description      String
  location         String
  area             String
  latitude         Float?
  longitude        Float?
  peopleAffected   Int            @default(0)
  injuriesReported Int            @default(0)
  trapped          Boolean        @default(false)
  priorityScore    Int            @default(0)
  priorityLevel    PriorityLevel  @default(LOW)
  priorityReasons  String[]
  reporterId       String
  reporter         User           @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  assignments   IncidentAssignment[]
  statusHistory IncidentStatusHistory[]

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([area])
  @@index([reporterId])
  @@index([createdAt])
  @@index([priorityLevel])
}

model SOSRequest {
  id                 String            @id @default(cuid())
  citizenId          String
  citizen            User              @relation("SOSCitizen", fields: [citizenId], references: [id], onDelete: Cascade)
  need               String
  category           SOSCategory       @default(OTHER)
  people             Int               @default(1)
  injuriesReported   Int               @default(0)
  trapped            Boolean           @default(false)
  priorityScore      Int               @default(0)
  priorityLevel      PriorityLevel     @default(LOW)
  priorityReasons    String[]
  location           String
  area               String?
  latitude           Float?
  longitude          Float?
  details            String?
  phone              String?
  status             SOSStatus         @default(SUBMITTED)
  responderProfileId String?
  responderProfile   ResponderProfile? @relation("SOSResponder", fields: [responderProfileId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  statusHistory SOSStatusHistory[]

  @@index([status])
  @@index([citizenId])
  @@index([createdAt])
  @@index([priorityLevel])
}

model SOSStatusHistory {
  id          String     @id @default(cuid())
  sosId       String
  sos         SOSRequest @relation(fields: [sosId], references: [id], onDelete: Cascade)
  fromStatus  SOSStatus?
  toStatus    SOSStatus
  changedById String
  changedBy   User       @relation("SOSStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  note        String?
  createdAt   DateTime   @default(now())

  @@index([sosId, createdAt])
  @@index([changedById])
}

model Shelter {
  id          String        @id @default(cuid())
  name        String
  address     String
  area        String
  capacity    Int
  occupied    Int           @default(0)
  facilities  String[]
  accessibility String?
  contact     String?
  latitude    Float?
  longitude   Float?
  status      ShelterStatus @default(OPEN)
  createdById String?
  createdBy   User?         @relation("ShelterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([area])
  @@index([status])
}

model DisasterAlert {
  id           String      @id @default(cuid())
  title        String
  type         String
  severity     Severity
  area         String
  instructions String
  source       String      @default("District Disaster Office")
  status       AlertStatus @default(DRAFT)
  reach        Int         @default(0)
  issuedById   String?
  issuedBy     User?       @relation("AlertIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt     DateTime    @default(now())
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([area])
  @@index([severity])
  @@index([issuedAt])
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  body              String
  type              NotificationType @default(SYSTEM)
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model IncidentAssignment {
  id                 String           @id @default(cuid())
  incidentId         String
  incident           Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responderProfileId String
  responderProfile   ResponderProfile @relation(fields: [responderProfileId], references: [id], onDelete: Cascade)
  assignedById       String
  assignedBy         User             @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  status             AssignmentStatus @default(PENDING)
  notes              String?
  assignedAt         DateTime         @default(now())
  respondedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([incidentId, responderProfileId])
  @@index([responderProfileId, status])
  @@index([incidentId])
}

model IncidentStatusHistory {
  id          String          @id @default(cuid())
  incidentId  String
  incident    Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromStatus  IncidentStatus?
  toStatus    IncidentStatus
  changedById String
  changedBy   User            @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  note        String?
  createdAt   DateTime        @default(now())

  @@index([incidentId, createdAt])
  @@index([changedById])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  targetType String
  targetId   String?
  details    Json?
  result     AuditResult @default(SUCCESS)
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([result])
  @@index([createdAt])
}
