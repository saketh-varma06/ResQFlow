# ===== ResQFlow — environment template (copy to .env, never invent/commit real secrets) =====
# App
NODE_ENV=development
# Backend
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Database (matches docker-compose.yml defaults for LOCAL development only)
POSTGRES_USER=resqflow
POSTGRES_PASSWORD=resqflow_dev_password
POSTGRES_DB=resqflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resqflow:resqflow_dev_password@localhost:5432/resqflow?schema=public
TEST_DATABASE_URL=postgresql://resqflow:resqflow_dev_password@localhost:5432/resqflow_test?schema=public
# MongoDB Atlas (prepared, not yet connected) — set only when migrating; the app currently runs on PostgreSQL via DATABASE_URL
MONGODB_URI=
# Auth (generate your own long random values locally; placeholders only)
JWT_SECRET=change_me_to_a_long_random_local_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Frontend (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:4000
# VITE_SOCKET_URL: reserved — the app currently derives the socket target from VITE_API_URL
VITE_SOCKET_URL=http://localhost:4000
